    "metric_definitions": {
      "revenue_growth": {
        "formula": "revenue_t / revenue_(t-1) − 1",
        "items": [
          "revenue"
        ],
        "not_meaningful": "NM for the first year, after a gap, or when prior revenue ≤ 0",
        "basis": "derived"
      },
      "gross_profit": {
        "formula": "revenue − cogs",
        "items": [
          "revenue",
          "cogs"
        ],
        "not_meaningful": "—",
        "basis": "derived"
      },
      "gross_margin": {
        "formula": "(revenue − cogs) / revenue",
        "items": [
          "revenue",
          "cogs"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "ebitda": {
        "formula": "ebit + da (standardised, D-03)",
        "items": [
          "ebit",
          "da"
        ],
        "not_meaningful": "—",
        "basis": "derived"
      },
      "ebitda_margin": {
        "formula": "(ebit + da) / revenue",
        "items": [
          "ebit",
          "da",
          "revenue"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "ebit_margin": {
        "formula": "ebit / revenue",
        "items": [
          "ebit",
          "revenue"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "net_margin": {
        "formula": "net_income / revenue",
        "items": [
          "net_income",
          "revenue"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "effective_tax_rate": {
        "formula": "tax_expense / pretax_income",
        "items": [
          "tax_expense",
          "pretax_income"
        ],
        "not_meaningful": "NM when pre-tax income ≤ 0",
        "basis": "derived"
      },
      "simple_fcf": {
        "formula": "cfo − capex",
        "items": [
          "cfo",
          "capex"
        ],
        "not_meaningful": "—",
        "basis": "derived"
      },
      "fcf_conversion": {
        "formula": "(cfo − capex) / net_income",
        "items": [
          "cfo",
          "capex",
          "net_income"
        ],
        "not_meaningful": "NM when net income ≤ 0",
        "basis": "derived"
      },
      "capex_pct_revenue": {
        "formula": "capex / revenue",
        "items": [
          "capex",
          "revenue"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "da_pct_revenue": {
        "formula": "da / revenue",
        "items": [
          "da",
          "revenue"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "capex_to_da": {
        "formula": "capex / da",
        "items": [
          "capex",
          "da"
        ],
        "not_meaningful": "NM when D&A ≤ 0",
        "basis": "derived"
      },
      "nwc": {
        "formula": "AR + inventory + other op. current assets − AP − other op. current liabilities (operating NWC)",
        "items": [
          "accounts_receivable",
          "inventory",
          "other_current_operating_assets",
          "accounts_payable",
          "other_current_operating_liabilities"
        ],
        "not_meaningful": "—; the two 'other' items are optional and disclosed",
        "basis": "derived"
      },
      "nwc_pct_revenue": {
        "formula": "operating NWC / revenue",
        "items": [
          "accounts_receivable",
          "inventory",
          "other_current_operating_assets",
          "accounts_payable",
          "other_current_operating_liabilities",
          "revenue"
        ],
        "not_meaningful": "NM when revenue ≤ 0",
        "basis": "derived"
      },
      "change_in_nwc": {
        "formula": "NWC_t − NWC_(t-1)",
        "items": [
          "accounts_receivable",
          "inventory",
          "other_current_operating_assets",
          "accounts_payable",
          "other_current_operating_liabilities"
        ],
        "not_meaningful": "NM for the first year or after a gap",
        "basis": "derived"
      },
      "net_debt": {
        "formula": "total_debt − cash",
        "items": [
          "total_debt",
          "cash"
        ],
        "not_meaningful": "—",
        "basis": "derived"
      },
      "net_debt_to_ebitda": {
        "formula": "(total_debt − cash) / (ebit + da)",
        "items": [
          "total_debt",
          "cash",
          "ebit",
          "da"
        ],
        "not_meaningful": "NM when EBITDA ≤ 0",
        "basis": "derived"
      },
      "interest_coverage": {
        "formula": "ebit / interest_expense",
        "items": [
          "ebit",
          "interest_expense"
        ],
        "not_meaningful": "NM when interest expense ≤ 0",
        "basis": "derived"
      },
      "current_ratio": {
        "formula": "total_current_assets / total_current_liabilities",
        "items": [
          "total_current_assets",
          "total_current_liabilities"
        ],
        "not_meaningful": "NM when total current liabilities are 0; missing if any input is missing",
        "basis": "derived"
      },
      "quick_ratio": {
        "formula": "(cash + marketable_securities + accounts_receivable) / total_current_liabilities",
        "items": [
          "cash",
          "marketable_securities",
          "accounts_receivable",
          "total_current_liabilities"
        ],
        "not_meaningful": "NM when total current liabilities are 0; missing if any input is missing",
        "basis": "derived"
      },
      "cash_ratio": {
        "formula": "(cash + marketable_securities) / total_current_liabilities",
        "items": [
          "cash",
          "marketable_securities",
          "total_current_liabilities"
        ],
        "not_meaningful": "NM when total current liabilities are 0; missing if any input is missing",
        "basis": "derived"
      }
    }
  }
